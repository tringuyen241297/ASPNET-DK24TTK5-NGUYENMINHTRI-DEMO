@model CakeShop.Areas.Admin.Data.AdminLoginVM
@using Microsoft.AspNetCore.Mvc;
@{
    ViewData["Title"] = "Đăng Nhập Quản Trị";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAccount.cshtml";
}

<style>
    /* Apple Store Admin Login Style */
    .admin-login-wrapper {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: #1d1d1f;
    }
    .heading-section {
        font-weight: 600;
        font-size: 28px;
        letter-spacing: -0.5px;
        margin-top: 15px;
    }
    .sub-heading {
        color: #86868b;
        font-size: 15px;
        margin-bottom: 30px;
    }
    .form-control {
        border-radius: 12px;
        padding: 14px 16px;
        border: 1px solid #d2d2d7;
        font-size: 17px;
        transition: border-color 0.3s, box-shadow 0.3s;
        background-color: rgba(255, 255, 255, 0.8);
    }
    .form-control:focus {
        border-color: #0071e3;
        box-shadow: 0 0 0 4px rgba(0,113,227,0.1);
        outline: none;
    }
    .btn-primary.submit {
        background-color: #0071e3;
        color: #fff;
        border: none;
        border-radius: 12px;
        font-size: 17px;
        font-weight: 500;
        padding: 12px;
        transition: all 0.3s;
        margin-top: 10px;
    }
    .btn-primary.submit:hover {
        background-color: #005bb5;
    }
    .btn-return {
        background-color: #f5f5f7;
        color: #1d1d1f;
        border: none;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 500;
        padding: 10px;
        transition: all 0.3s;
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
    }
    .btn-return:hover {
        background-color: #e8e8ed;
        color: #1d1d1f;
        text-decoration: none;
    }
    .text-warning {
        color: #ff3b30 !important; /* Màu đỏ báo lỗi chuẩn Apple */
        font-size: 14px;
    }
    .forgot-link {
        color: #0071e3;
        text-decoration: none;
        font-size: 14px;
    }
    .forgot-link:hover {
        text-decoration: underline;
    }
    .checkbox-wrap {
        color: #1d1d1f;
        font-size: 14px;
        cursor: pointer;
    }
    .password-icon-wrapper {
        position: relative;
    }
    .toggle-password {
        position: absolute;
        right: 15px;
        top: 18px;
        cursor: pointer;
        color: #86868b;
    }
</style>

<div class="row justify-content-center align-items-center admin-login-wrapper mt-5">
    <div class="col-md-6 text-center mb-4">
        <!-- Icon quả táo cho đúng chất quản trị Apple -->
        <i class="fa fa-apple fa-4x" style="color: #1d1d1f;"></i>
        <h2 class="heading-section">Apple Store Admin</h2>
        <p class="sub-heading">Đăng nhập bằng ID Quản trị viên của bạn</p>
    </div>
</div>

<div class="row justify-content-center mb-md-5 admin-login-wrapper">
    <div class="col-md-6 col-lg-4">
        <div class="login-wrap p-4" style="background: #ffffff; border-radius: 20px; box-shadow: 0 4px 24px rgba(0,0,0,0.06);">
            <form id="admin" method="post" class="signin-form">
                <b><div class="text-warning text-center mb-3" asp-validation-summary="All"></div></b>
                
                <div class="form-group mb-3">
                    <input type="text"
                           class="form-control"
                           asp-for="@Model.UserName"
                           placeholder="Tên đăng nhập (Admin ID)"
                           required />
                    <span asp-validation-for="@Model.UserName" class="text-danger mt-1 d-block" style="font-size: 13px;"></span>
                </div>
                
                <div class="form-group mb-4 password-icon-wrapper">
                    <input asp-for="@Model.Password"
                           type="password"
                           id="password-field"
                           class="form-control"
                           placeholder="Mật khẩu"
                           required />
                    <span toggle="#password-field"
                          class="fa fa-fw fa-eye field-icon toggle-password"></span>
                    <span asp-validation-for="@Model.Password" class="text-danger mt-1 d-block" style="font-size: 13px;"></span>
                </div>
                
                <div class="form-group">
                    <button type="submit"
                            class="form-control btn btn-primary submit px-3">
                        Đăng nhập
                    </button>
                </div>
                
                <div class="form-group d-flex justify-content-between align-items-center mt-3">
                    <div>
                        <label class="checkbox-wrap checkbox-primary mb-0 d-flex align-items-center">
                            <input type="checkbox" checked class="mr-2" />
                            Ghi nhớ ID
                            <span class="checkmark"></span>
                        </label>
                    </div>
                    <div class="text-right">
                        <a href="#" class="forgot-link">Bạn quên mật khẩu?</a>
                    </div>
                </div>
            </form>
            
            <hr style="border-top: 1px solid #d2d2d7; margin: 25px 0;">
            
            <a asp-action="Index" asp-controller="Home" class="btn-return w-100">
                <i class="fa fa-long-arrow-left mr-2"></i> Trở về Trang chủ Cửa hàng
            </a>
        </div>
    </div>
</div>